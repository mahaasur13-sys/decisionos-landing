    /* ===== Decision AI Chat Widget ===== */
    .chat-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 14px 16px; border-bottom: 1px solid #21262d;
      background: #161b22; flex-shrink: 0;
    }
    .chat-title { display: flex; align-items: center; gap: 10px; color: #e6edf3; }
    .chat-avatar {
      width: 36px; height: 36px; border-radius: 50%;
      background: linear-gradient(135deg, #6c5ce7, #a855f7);
      display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;
    }
    .chat-title strong { font-size: 15px; display: block; }
    .chat-title small { font-size: 11px; color: #8b949e; display: block; }
    .chat-header-actions { display: flex; gap: 6px; }
    .chat-header-btn {
      background: none; border: 1px solid #30363d; color: #8b949e;
      width: 32px; height: 32px; border-radius: 8px; cursor: pointer;
      font-size: 16px; display: flex; align-items: center; justify-content: center;
      transition: background 0.15s, color 0.15s;
    }
    .chat-header-btn:hover { background: #21262d; color: #e6edf3; }
    .chat-messages {
      flex: 1; overflow-y: auto; padding: 16px;
      display: flex; flex-direction: column; gap: 10px;
    }
    .chat-messages::-webkit-scrollbar { width: 5px; }
    .chat-messages::-webkit-scrollbar-thumb { background: #30363d; border-radius: 10px; }
    .chat-message { max-width: 85%; padding: 10px 14px; border-radius: 14px; font-size: 13px; line-height: 1.5; word-break: break-word; }
    .chat-message.user { align-self: flex-end; background: #6c5ce7; color: #fff; border-bottom-right-radius: 4px; }
    .chat-message.bot { align-self: flex-start; background: #161b22; color: #e6edf3; border: 1px solid #30363d; border-bottom-left-radius: 4px; }
    .chat-message.bot.typing { color: #8b949e; font-style: italic; }
    .chat-input-area {
      padding: 12px 16px; border-top: 1px solid #21262d; background: #161b22;
      display: flex; gap: 8px; align-items: flex-end; flex-shrink: 0;
    }
    .chat-input-area textarea {
      flex: 1; background: #0d1117; border: 1px solid #30363d; border-radius: 12px;
      color: #e6edf3; padding: 10px 14px; font-size: 13px; resize: none;
      min-height: 38px; max-height: 130px; outline: none; font-family: inherit;
    }
    .chat-input-area textarea:focus { border-color: #6c5ce7; }
    .chat-input-area button {
      background: #6c5ce7; border: 0; color: #fff; width: 38px; height: 38px;
      border-radius: 12px; cursor: pointer; font-size: 18px;
      display: flex; align-items: center; justify-content: center;
      transition: background 0.15s; flex-shrink: 0;
    }
    .chat-input-area button:hover { background: #7c3aed; }
    .chat-input-area button:disabled { background: #21262d; color: #484f58; cursor: not-allowed; }
    .chat-input-area button.hidden { display: none; }
    .chat-api-badge {
      display: flex; align-items: center; gap: 5px; font-size: 11px;
      padding: 3px 10px; border-radius: 20px; background: #161b22;
      border: 1px solid #21262d; color: #8b949e; margin-right: auto;
      transition: border-color 0.2s;
    }
    .chat-api-badge .dot { width: 6px; height: 6px; border-radius: 50%; background: #484f58; }
    .chat-api-badge.active { border-color: #238636; }
    .chat-api-badge.active .dot { background: #3fb950; }
    @media (max-width: 600px) {
      .chat-panel { inset: 0; width: 100%; height: 100%; max-width: 100%; max-height: 100%; border: 0; border-radius: 0; }
      .chat-toggle { right: 16px; bottom: 16px; }
    }
    /* API Key Modal */
    .api-key-overlay {
      position: fixed; inset: 0; z-index: 99999; background: rgba(0,0,0,0.65);
      display: none; align-items: center; justify-content: center;
    }
    .api-key-overlay.open { display: flex; }
    .api-key-modal {
      background: #161b22; border: 1px solid #30363d; border-radius: 16px;
      padding: 28px; width: 400px; max-width: 90vw; box-shadow: 0 16px 48px rgba(0,0,0,0.6);
    }
    .api-key-modal h3 { color: #e6edf3; margin: 0 0 12px; font-size: 18px; }
    .api-key-modal p { color: #8b949e; font-size: 13px; margin: 0 0 16px; }
    .api-key-modal .input-wrap { position: relative; margin-bottom: 16px; }
    .api-key-modal input {
      width: 100%; background: #0d1117; border: 1px solid #30363d; border-radius: 10px;
      color: #e6edf3; padding: 10px 40px 10px 14px; font-size: 13px; outline: none; box-sizing: border-box;
    }
    .api-key-modal input:focus { border-color: #6c5ce7; }
    .api-key-eye {
      position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
      background: none; border: 0; color: #8b949e; cursor: pointer; font-size: 18px; padding: 4px 8px;
    }
    .api-key-eye:hover { color: #e6edf3; }
    .api-key-actions { display: flex; gap: 8px; }
    .api-key-actions button {
      flex: 1; padding: 10px; border-radius: 10px; font-size: 13px; cursor: pointer;
      border: 1px solid #30363d; transition: background 0.15s;
    }
    .btn-save { background: #6c5ce7; color: #fff; border-color: #6c5ce7; }
    .btn-save:hover { background: #7c3aed; }
    .btn-delete { background: transparent; color: #f85149; border-color: #f8514922; }
    .btn-delete:hover { background: #f8514922; }
    .btn-cancel { background: transparent; color: #8b949e; }
    .btn-cancel:hover { background: #21262d; }
  </style>
</head>
